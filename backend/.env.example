PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Database
DB_PATH=./storage/data/app.db

# Storage
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE=52428800

# Security & Admin Key
ADMIN_API_KEY=visionx-admin-secure-key-2026

# AI Configuration (Optional: runs local deterministic NLP parser by default)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Authoritative Pricing
PRICE_BW=2.0
PRICE_COLOR=8.0
DUPLEX_DISCOUNT=0.15
BULK_THRESHOLD=10
BULK_DISCOUNT=0.10
CURRENCY=₹

# Session Management
SESSION_TTL_MINUTES=30
